                agent {
                    label "cpp && ${ARCHITECTURE}"
                }
                environment {
                    BUILD_DIR = "${WORKSPACE}/.jenkins-build/build"
                    DEBUG_BUILD_DIR = "${WORKSPACE}/.jenkins-build/build_d"
                    INSTALL_DIR = "${WORKSPACE}/.jenkins-build/install"
                    DEBUG_INSTALL_DIR = "${WORKSPACE}/.jenkins-build/install_d"
                    PACKAGE_DIR = "${WORKSPACE}/.jenkins-build/packages"
                }

                stages {
                    stage('Prepare') {
                        steps {
                            // 前回のキャッシュ, テスト結果, パッケージを残さずに開始します.
                            dir('.jenkins-build') {
