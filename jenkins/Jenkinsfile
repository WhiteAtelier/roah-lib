                    stage('Run tests (release)') {
                        steps {
                            script {
                                runCommand("ctest --test-dir \"${env.BUILD_DIR}\" -C Release " +
                                    '--output-on-failure --no-tests=error ' +
                                    "--output-junit \"${env.BUILD_DIR}/test-results.xml\"")
                            }
                        }
                        post {
                            always {
                                script {
                                    if (fileExists('.jenkins-build/build/test-results.xml')) {
                                        junit testResults: '.jenkins-build/build/test-results.xml'
                                    }
                                }
                            }
                        }
                    }

                    stage('Package') {
                        steps {
                            script {
                                runCommand("cpack --config \"${env.BUILD_DIR}/CPackConfig.cmake\" " +
                                    "-C Release -G TGZ -B \"${env.PACKAGE_DIR}\"")
                            }
                            archiveArtifacts(
                                artifacts: '.jenkins-build/packages/libroah.*.tar.gz',
                                fingerprint: true,
                                onlyIfSuccessful: true,
