                            }
                        }
                    }

                    stage('Debug') {
                        when {
                            expression {
                                // Linux ではコンパイラの種類によらず Debug をスキップします.
                                !isUnix() || sh(script: 'uname -s', returnStdout: true).trim() != 'Linux'
                            }
                        }
                        stages {
                            stage('Configure roah-lib (debug)') {
                                steps {
                                    script {
                                        runCommand("cmake --preset default -S \"${env.WORKSPACE}\" -B \"${env.DEBUG_BUILD_DIR}\" " +
                                            "--install-prefix \"${env.DEBUG_INSTALL_DIR}\" " +
                                            '-DCMAKE_BUILD_TYPE=Debug ' +
                                            '-DLIBROAH_INSTALL=ON -DLIBROAH_BUILD_DOCS=ON -DLIBROAH_BUILD_TESTS=ON')
                                    }
                                }
                            }

                            stage('Build roah-lib (debug)') {
                                steps {
                                    script {
                                        runCommand("cmake --build \"${env.DEBUG_BUILD_DIR}\" --config Debug --parallel")
                                    }
                                }
                            }

                            stage('Install roah-lib (debug)') {
                                steps {
                                    script {
                                        runCommand("cmake --install \"${env.DEBUG_BUILD_DIR}\" --config Debug")
                                    }
                                }
                            }

                            stage('Run tests (debug)') {
                                steps {
                                    script {
                                        runCommand("ctest --test-dir \"${env.DEBUG_BUILD_DIR}\" -C Debug " +
                                            '--output-on-failure --no-tests=error ' +
                                            "--output-junit \"${env.DEBUG_BUILD_DIR}/test-results.xml\"")
                                    }
                                }
                                post {
                                    always {
                                        script {
                                            if (fileExists('.jenkins-build/build_d/test-results.xml')) {
                                                junit testResults: '.jenkins-build/build_d/test-results.xml'
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    stage('Configure roah-lib (release)') {
                        steps {
                            script {
                                runCommand("cmake --preset default -S \"${env.WORKSPACE}\" -B \"${env.BUILD_DIR}\" " +
                                    "--install-prefix \"${env.INSTALL_DIR}\" " +
                                    '-DCMAKE_BUILD_TYPE=Release ' +
                                    '-DLIBROAH_INSTALL=ON -DLIBROAH_BUILD_DOCS=ON -DLIBROAH_BUILD_TESTS=ON')
                            }
                        }
                    }

                    stage('Build roah-lib (release)') {
                        steps {
                            script {
                                runCommand("cmake --build \"${env.BUILD_DIR}\" --config Release --parallel")
                            }
