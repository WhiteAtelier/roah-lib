// agent の OS に応じてコマンドを実行し, 失敗時はパイプラインを停止します.
def runCommand(String command) {
    if (isUnix()) {
        sh command
    } else {
        bat "@${command}"
    }
}

pipeline {
    agent none

    stages {
        stage('Build architectures') {
            matrix {
                axes {
                    axis {
                        name 'ARCHITECTURE'
                        values 'arm64', 'x86_64'
                    }
