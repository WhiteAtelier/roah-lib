file(WRITE @ROAH_UNINSTALL_SH_BUILD_PATH@ "#!/bin/sh\n")

message("Generating uninstall.sh at @ROAH_UNINSTALL_SH_BUILD_PATH@")

foreach(FILE_PATH IN LISTS CMAKE_INSTALL_MANIFEST_FILES)
    file(APPEND @ROAH_UNINSTALL_SH_BUILD_PATH@ "rm -f \"${FILE_PATH}\"\n")
endforeach()

file(APPEND @ROAH_UNINSTALL_SH_BUILD_PATH@ "echo \"Uninstallation complete.\"\n")
file(APPEND @ROAH_UNINSTALL_SH_BUILD_PATH@ "exit 0\n")

file(
    CHMOD
        @ROAH_UNINSTALL_SH_BUILD_PATH@
    PERMISSIONS
        OWNER_EXECUTE OWNER_WRITE OWNER_READ
        GROUP_EXECUTE GROUP_READ
        WORLD_EXECUTE WORLD_READ
)
